{
  "name": "spriebsch/uuid",
  "description": "A fast and simple no-frills UUIDv4 implementation.",
  "authors": [
    {
      "name": "Stefan Priebsch",
      "email": "stefan@priebsch.de",
      "homepage": "https://priebsch.de"
    }
  ],
  "license": "BSD-3-Clause",
  "autoload": {
    "classmap": [
      "src"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "prefer-stable": true,
  "require": {
    "php": "^8.3"
  },
  "scripts": {
    "clean": "rm -rf build/*"
  }
}
